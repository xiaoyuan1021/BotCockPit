<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>botcockpit_bridge</name>
  <version>0.1.0</version>
  <description>BotCockpit TCP bridge: protocol v0.1 gateway between Qt Console and ROS2 robot</description>
  <maintainer email="dev@botcockpit.local">BotCockpit</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
